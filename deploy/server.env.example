# Copy the private local .env first, then add these server-specific settings.
# Choose actual mounted disks after running server-preflight.sh.
RELEASE_TAG=server-20261117
PG_DATA_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/pg
MINIO_DATA_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/minio
APP_KEYS_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/keys
CATALOG_CACHE_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/catalog-cache
BACKUP_DIR=/mnt/REPLACE_BACKUP_DISK/movie-discovery

FRONT_PUBLIC_URL=https://REPLACE_WITH_YOUR_DOMAIN
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/movie-discovery/cloudflare-token

PG_PORT=5433
API_PORT=5200
WEB_PORT=3001
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
IMDB_AUTO_SYNC_INTERVAL_HOURS=24
TMDB_AUTO_SYNC_INTERVAL_HOURS=24
TMDB_AUTO_SYNC_PAGES=5

# Optional Brave Search. The plan must permit storing matched URLs.
WATCH_WEB_ENABLED=false
BRAVE_SEARCH_API_KEY=
WATCH_WEB_DAILY_REQUESTS=32

# Run a single Telegram polling instance after cutover.
# Linux has no Windows-host Ollama instance. Set an actual reachable service if used.
OLLAMA_URL=
