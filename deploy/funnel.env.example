# Append these settings to a private copy of the source .env.
# The public profile is docker-compose.funnel.yml.
RELEASE_TAG=funnel-20261117
PG_DATA_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/pg
MINIO_DATA_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/minio
APP_KEYS_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/keys
CATALOG_CACHE_DIR=/mnt/REPLACE_DATA_DISK/movie-discovery/catalog-cache
BACKUP_DIR=/mnt/REPLACE_BACKUP_DISK/movie-discovery

# Get the actual address after signing the VPS into Tailscale.
FRONT_PUBLIC_URL=https://REPLACE_SERVER.REPLACE_TAILNET.ts.net
APP_NETWORK_SUBNET=172.29.87.0/24
PG_PORT=5433
API_PORT=5200
WEB_PORT=3001
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
IMDB_AUTO_SYNC_INTERVAL_HOURS=24
TMDB_AUTO_SYNC_INTERVAL_HOURS=24
TMDB_AUTO_SYNC_PAGES=5
OLLAMA_URL=

# Optional Brave Search. The plan must permit storing matched URLs.
WATCH_WEB_ENABLED=false
BRAVE_SEARCH_API_KEY=
WATCH_WEB_DAILY_REQUESTS=32

# Set unique destination credentials before initializing the new database.
POSTGRES_PASSWORD=REPLACE_WITH_NEW_SECRET
ADMIN_KEY=REPLACE_WITH_NEW_SECRET
BOT_API_KEY=REPLACE_WITH_NEW_SECRET
MINIO_MINIO_PASSWORD=REPLACE_WITH_NEW_SECRET

# Only when a Workers frontend calls this VPS through Funnel.
# Put the same value in the Worker's API_PROXY_SHARED_SECRET secret.
API_PROXY_SHARED_SECRET=

# Configure SMTP for address confirmation and password-reset delivery.
MAIL_ENABLED=true
MAIL_REQUIRE_CONFIRMED_EMAIL=true
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_FROM=REPLACE_SENDER_EMAIL
