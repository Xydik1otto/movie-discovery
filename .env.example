# Скопіювати в .env і заповнити. .env в git НЕ потрапляє.
POSTGRES_USER=movie
POSTGRES_PASSWORD=changeme_pg
POSTGRES_DB=moviediscovery
PG_PORT=5433

# Безкоштовний ключ: реєстрація на https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Опційно: https://www.omdbapi.com/apikey.aspx (free 1000/день)
OMDB_API_KEY=

# Локальні embeddings (bge-m3). Поза Docker: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=bge-m3

ADMIN_KEY=changeme_admin
API_PORT=5200
WEB_PORT=3001

# Аніме/манга-каталог: PRIMARY — AniList (без ключа); extra-шар — офіційний MAL API v2.
# Безкоштовний client ID: https://myanimelist.net/apis.php
MAL_CLIENT_ID=
# Jikan (дзеркало MAL) — dormant: EOL/недоступний хост; лишено на випадок робочих дзеркал
JIKAN_URL=https://api.jikan.moe/v4

# Telegram-бот (BotFather). Порожньо = бот чекає токена і не падає.
TG_BOT_TOKEN=
API_URL=http://api:5200

# MD-05: ключ авторизації запитів бота до API (заголовок X-Bot-Key).
# Порожньо = bot-авторизацію вимкнено (усі bot-запити отримають 403).
BOT_API_KEY=
# MD-01: id designated guest profile для анонімного серверного списку (за замовчуванням 1).
GUEST_PROFILE_ID=1
